<div class="row">
  <div class="column">
    <!-- Main information, edit it on theme/_config.yml -->
    <h2 class="mb-2 noindent toleft"><%= theme.owner %></h2>
  </div>
</div>

<h3 class="noindent" style="font-size: 1.9rem !important;"><a href="<%= config.root %>archives">最新文章</a></h3>

<% site.posts.sort('date', 'desc').limit(theme.max_post).forEach(function(post){ %>
<div class="row">
  <div class="three columns left lit noindent">
    <p class="bottom noindent"><%- full_date(post.date, 'll') %></p>
  </div>
  <div class="nine columns left mb-3 noindent">
    <a href="<%- url_for(post.path) %>" >
      <% if (post.title == "") { %>
        no title
      <% } else { %>
        <%- post.title %>
      <% } %>
    </a>
  </div>
</div>
<% }) %>

